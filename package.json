{
  "name": "@readest/monorepo",
  "private": true,
  "repository": "readest/readest",
  "scripts": {
    "test": "corepack pnpm --filter @readest/readest-app test:run",
    "test:browser": "corepack pnpm --filter @readest/readest-app test:browser",
    "lint": "corepack pnpm --filter @readest/readest-app lint",
    "tauri": "corepack pnpm --filter @readest/readest-app tauri",
    "dev-web": "corepack pnpm --filter @readest/readest-app dev-web",
    "dev-web:local": "corepack pnpm --filter @readest/readest-app dev-web:local",
    "start-web:local": "corepack pnpm --filter @readest/readest-app start-web:local",
    "build:web": "corepack pnpm --filter @readest/readest-app build-web",
    "check:built-web": "corepack pnpm --filter @readest/readest-app check:all",
    "setup:vendors": "corepack pnpm --filter @readest/readest-app setup-vendors",
    "prepare": "husky",
    "fmt:check": "corepack pnpm --filter @readest/readest-app fmt:check",
    "clippy:check": "corepack pnpm --filter @readest/readest-app clippy:check",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,css,json,md,html,yml}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,css,json,md,html,yml}\"",
    "deps:check": "corepack pnpm outdated -r",
    "deps:audit": "corepack pnpm audit"
  },
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.11.0 <12"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@sindresorhus/tsconfig": "^8.1.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,css,json,md,html,yml}": [
      "prettier --write"
    ]
  }
}
