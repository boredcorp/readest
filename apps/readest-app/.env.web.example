NEXT_PUBLIC_APP_PLATFORM=web
# Required for every LearningBored private-beta build, including rollout builds with Board it off.
NEXT_PUBLIC_LEARNINGBORED_DEPLOYMENT_PROFILE=private_beta
AI_GATEWAY_API_KEY=your_key_here
NEXT_PUBLIC_AI_GATEWAY_API_KEY=your_key_here

# The private-beta profile requires the exact private server gateway, public browser origin, and
# opaque publishable key in production. Despite the inherited variable name, do not put a legacy
# HS256 anon JWT in NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_LEARNINGBORED_ENABLED=false
NEXT_PUBLIC_LEARNINGBORED_API_BASE_URL=https://api.learningbored.com
SUPABASE_URL=http://learningbored-supabase-gateway:8000
NEXT_PUBLIC_SUPABASE_URL=https://supabase.learningbored.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YOUR_LEARNINGBORED_KEY
